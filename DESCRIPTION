Package: multistrata
Type: Package
Title: Multivariate Optimum Stratification and Sample Allocation for Surveys
Version: 1.0-1
Date: 2026-09-26
Authors@R: c(
    person("Karuna G.", "Reddy",
           email = "karuna.reddy@auckland.ac.nz",
